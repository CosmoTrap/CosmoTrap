# Cosmotrap sur Hostinger (Apache / LiteSpeed)

# notre index.html passe avant l'éventuel index.php / default.php de la page « Bientôt disponible »
DirectoryIndex index.html
Options -Indexes

# types des ressources 3D et audio
AddType model/gltf-binary .glb
AddType application/octet-stream .hdr
AddType application/wasm .wasm
AddType audio/mpeg .mp3

# compression des fichiers texte (JS, CSS, JSON, SVG)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml model/gltf-binary
</IfModule>

# cache : les fichiers de dist/assets portent une empreinte → un an ; index.html jamais en cache
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(glb|hdr|jpg|jpeg|png|webp|mp3|ogg|wasm)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# fichiers internes du déploiement jamais servis
<FilesMatch "^\.ftp-deploy-sync-state\.json$">
  Require all denied
</FilesMatch>
